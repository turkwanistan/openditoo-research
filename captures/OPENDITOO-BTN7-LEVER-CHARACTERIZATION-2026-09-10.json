 "findings": [
  {
   "id": "SHORT-PULL-IS-ONE-SMTC-EVENT-IN-MIRROR-MODE",
   "confidence": "MATCHED",
   "statement": "8/8 short pulls produced exactly one SMTC event, strictly alternating Pause/Play in step with the mirrored status. Play/Pause together are one 'lever' input."
  },
  {
   "id": "0xBD-ACCOMPANIES-EVERY-PLAY-DIRECTION-PULL",
   "confidence": "MATCHED",
   "statement": "4/4 short Play pulls carried RFCOMM 0xBD (Host-detected within -163..+148 ms of the SMTC callback); 0/5 Pause pulls did. Together with M7 (0xBD 1.7 ms before AVRCP Play), 0xBD is tied to the Ditoo entering its play state."
  },
  {
   "id": "0xBD-IS-NOT-A-VISIBLE-TAKEOVER-UNDER-RECLAIM",
   "confidence": "OPERATOR_OBSERVATION",
   "statement": "Six 0xBD session ends, all reclaimed (46-69 ms reopen, one ~1 s via the 409 race); operator saw nothing on the screen. The Host fence is kept; the product tolerates it by reclaim and page state outside the session."
  },
  {
   "id": "BTN2-TRIAL-B-EXPLAINED",
   "confidence": "MATCHED",
   "statement": "With a fixed 'Playing' status Windows delivered Pause but not Play; the lost trial-B lever was a Play-direction pull (its 0xBD reached the Host). Always-on broker must run in mirror mode."
  },
  {
   "id": "LONG-HOLD-UNRELIABLE",
   "confidence": "OBSERVED",
   "statement": "Two later actions (likely the hold and the extra pull) produced 0xBD with no SMTC event. Product semantics use short pulls only; a held lever may be lost."
  },
  {
   "id": "LONG-HOLD-ENTERED-A-DEVICE-MODE",
   "confidence": "OPERATOR_OBSERVATION (single)",
   "statement": "After the long holds the owner found the Ditoo in a 'recording' mode. The hold-type actions were exactly the ones that produced 0xBD with no Play/Pause event, i.e. the device did something other than toggle playback. Another 0xBD at 17:21:16.365 (after the capture) was reclaimed in 70 ms and the Host kept ACKing dashboard frames (displayState ours_last_acked). Nothing OpenDitoo sent can enter such a mode: the probe is receive-only and the Host sent only dashboard image frames.",
   "consequence": "Never ask for or map long lever holds. The lever product action is short-pull only; how the Ditoo's hold mode interacts with our frames is unmeasured."
  }
 ],
 "product_decision_basis": "lever = SMTC Play or Pause in mirror mode, short pull; acting on it costs a dashboard session end + reclaim on every other pull, invisible to the operator",
