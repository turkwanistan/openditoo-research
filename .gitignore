# Local credentials/runtime state
.openditoo-local/

# Python
__pycache__/
*.pyc

# .NET build outputs
bin/
obj/

# Windows/local build staging
runtime/windows/.build/

# Captures may contain unrelated personal Bluetooth/phone data.
# Commit only filtered, reviewed evidence explicitly.
captures/private/

# Windows-copied file metadata
*:Zone.Identifier

# Raw Android bugreports and HCI snoop logs contain the whole phone's Bluetooth
# traffic plus unrelated personal data. Never commit them; record SHA-256 only.
bugreport-*.zip
*btsnoop*
# ...but not the offline parser module, which the committed tests import and holds no capture data.
!host/btsnoop.py
runtime/windows/OpenDitoo.Day1.Host/bin/Streaming/
runtime/windows/OpenDitoo.Webcam.Probe/bin/
runtime/windows/OpenDitoo.Webcam.Probe/obj/
