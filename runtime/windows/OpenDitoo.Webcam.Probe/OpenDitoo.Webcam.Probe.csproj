<Project Sdk="Microsoft.NET.Sdk">

  <!-- W1 enumeration/benchmark only. Deliberately references nothing of the Ditoo Host:
       no Bluetooth, no token, no HTTP, no transport. It cannot reach the device. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>OpenDitoo.Webcam.Probe</AssemblyName>
    <RootNamespace>OpenDitoo.Webcam.Probe</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

</Project>
